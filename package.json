{
  "name": "tovuq-crm-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tovuq mahsulotlari distribyutori uchun offline CRM/ERP (Android APK / PWA)",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "serve": "npx --yes serve dist -l 5173",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2",
    "leaflet": "^1.9.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "esbuild": "^0.25.0"
  }
}
